# JARVIS headless core — environment configuration.
# Copy to .env for local use, or set these as real secrets/env vars on
# whatever platform hosts the headless service (Render/Railway/etc.).
# Never commit an actual .env file — it's covered by .gitignore.
# Variable NAMES only below — no real values belong in this file, ever.

# ── Required for the headless API ──────────────────────────────────────
# Pre-shared bearer token for core/headless/* (the Agent Orchestrator API,
# the tool-execution API) and, as an alternate credential alongside the
# desktop app's own pairing-key sessions, dashboard/server.py's /3d/api/*
# and /3d/ws. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset means every authenticated route returns 401/503 — closed by
# default, not open by default.
JARVIS_API_TOKEN=

# ── LLM provider — Ollama Cloud is THE provider (see
#    core/headless/ui.py:_configured_providers()'s docstring) ───────────
# Required for the headless service to hold a conversation at all — if
# unset, _configured_providers() returns an empty list and every chat
# surface (browser /ui, the 3D console, the Cartesia phone agent) fails.
OLLAMA_API_KEY=
OLLAMA_URL=https://ollama.com/api/chat
OLLAMA_MODEL=gpt-oss:120b-cloud

# ── Gemini/Groq — present but NOT in the active provider chain ─────────
# Their _run_chat_turn_* functions still exist and still work; adding
# "gemini"/"groq" back to _configured_providers()'s returned list is what
# it takes to re-enable one, deliberately not automatic from these being
# set. GEMINI_API_KEY (this one) is also separate from and does NOT set
# config/api_keys.json's own "gemini_api_key" field, which
# actions/web_search.py reads independently for Google Search grounding —
# unrelated to which LLM answers a chat turn.
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Google OAuth (Gmail + Calendar) — cloud bootstrap only ──────────────
# Local desktop use never sets these — it already has config/google/
# client_secret_*.json + token.json on disk from the one-time interactive
# consent flow (actions/google_auth.py's authorize_interactively()), which
# a headless cloud container can't run itself (no browser).
# To deploy with Gmail/Calendar already authorized: copy the CONTENTS of
# your local config/google/token.json into GOOGLE_TOKEN_JSON (and, if you
# haven't already downloaded it separately, client_secret_*.json into
# GOOGLE_CLIENT_SECRET_JSON) as secrets on the host platform. Written to
# disk once on first startup, never overwriting a file that already
# exists, never logged. See actions/google_auth.py:ensure_credentials_from_env().
GOOGLE_TOKEN_JSON=
GOOGLE_CLIENT_SECRET_JSON=

# ── Business integrations (optional — each degrades to NOT_CONFIGURED
#    if unset, never a fabricated success) ───────────────────────────────
AIRTABLE_TOKEN=
HUBSPOT_TOKEN=
# A Buffer "Public API" access token from
# https://publish.buffer.com/settings/api — NOT a REST-API-scoped token;
# Buffer's legacy REST API rejects this token type outright (confirmed
# live). Only the GraphQL API (api.buffer.com/graphql) is used — see
# actions/buffer_integration.py.
BUFFER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# JARVIS's own outbound SMS/call target (E.164, e.g. +13125550142) — where
# "call me" rings and where pending-approval notifications are texted.
JARVIS_OWNER_PHONE=

# ── Voice — Cartesia is the one provider for both surfaces (browser /ui's
#    Sonic playback and the phone line's Cartesia Line agent); same
#    CARTESIA_VOICE_ID in both places is why JARVIS sounds like one
#    person, not two ────────────────────────────────────────────────────
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_TTS_MODEL=sonic-3
# Only needed for JARVIS to place outbound calls himself — inbound works
# with neither set. Set after `cartesia deploy` and after a number is
# provisioned; see voice_agent/README.md for the order.
CARTESIA_AGENT_ID=
CARTESIA_PHONE_NUMBER_ID=

# ── ElevenLabs — an alternate/legacy TTS voice, separate from Cartesia ──
ELEVENLABS_API_KEY=

# ── Daily Deal Finders product-data discovery (optional) ───────────────
# A third-party product-data API key (e.g. Rainforest API, which mirrors
# Amazon listings without needing an approved Associates account) — see
# actions/ddf_discovery.py. Absent, discovery honestly reports
# NOT_CONFIGURED rather than fabricating data.
PRODUCT_DATA_API_KEY=
PRODUCT_DATA_API_PROVIDER=rainforest
PRODUCT_DATA_API_URL=https://api.rainforestapi.com/request

# ── Networking ────────────────────────────────────────────────────────
JARVIS_HEADLESS_HOST=0.0.0.0
JARVIS_HEADLESS_PORT=8787
# The public URL this service is reachable at — used to build links back
# to itself (e.g. in notifications). Defaults to the Render URL below if
# unset; only needed if that ever changes.
JARVIS_PUBLIC_URL=https://jarvis-headless-core.onrender.com

# ── Runtime data ──────────────────────────────────────────────────────
# All SQLite-backed runtime state (agent orchestrator, business
# intelligence, BuildPro records, opportunities, proactive log, Daily Deal
# Finders, Twilio/Buffer history, the app-instance lock) now resolves
# under this directory — see core/headless/config.py and
# tests/test_headless_core.py's JARVIS_DATA_DIR tests. Point this at your
# platform's persistent volume mount. Unset defaults to <repo>/data.
JARVIS_DATA_DIR=

# ── Obsidian knowledge layer (optional) ──────────────────────────────
# Absolute path to the vault directory. Unset = "not configured," reported
# honestly via the vault's status(), never guessed at.
#
# Local desktop: point this at the real vault path (OneDrive-synced), e.g.
#   C:\Users\<you>\OneDrive\Documents\JARVIS\BuildPro Operating System\JARVIS - BuildPro Operating System
# Verified working (real read + real write) against that vault during J3.
#
# Cloud (Render): there is currently NO sync mechanism moving the vault's
# files into the deployed container — this is a real, undone gap, not
# something core/headless/obsidian.py papers over. Setting this env var
# on Render only works once the vault's files exist somewhere the
# container can see them, e.g. on the same persistent disk as
# JARVIS_DATA_DIR, kept in sync by a process outside this codebase
# (OneDrive doesn't run on Linux; a git-backed vault + a sync job, or a
# mounted network share, are the realistic options). Until one of those
# exists, leave this unset in the Render environment — the vault stays
# correctly reported as "not configured" there rather than pointing at a
# path that doesn't exist in that container.
JARVIS_OBSIDIAN_VAULT_PATH=
